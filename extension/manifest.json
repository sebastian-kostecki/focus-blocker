{
  "manifest_version": 3,
  "name": "FocusBlocker",
  "version": "1.1.0",
  "description": "Pokazuje stronę z komunikatem zamiast stron zablokowanych przez FocusBlocker.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FocusBlocker – stan blokady",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["webNavigation", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" }
}
